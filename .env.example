# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=TOONTOON API
DEBUG=true

# Comma-separated list of allowed CORS origins (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public base URL of this backend (used to build absolute upload URLs).
PUBLIC_BASE_URL=http://localhost:8000

# Where to send the user after a successful login (frontend route).
FRONTEND_URL=http://localhost:3000
AUTH_SUCCESS_REDIRECT=/generate

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Set to true to use an in-memory fake Redis (handy for local dev / tests).
USE_FAKE_REDIS=false

# ─── Sessions ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=toontoon-session
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
# For cross-site cookies (frontend and backend on different origins) use:
#   SESSION_COOKIE_SAMESITE=none and SESSION_COOKIE_SECURE=true (requires HTTPS).
# When the frontend proxies /api to the backend (same origin), "lax" is fine.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# Starting balance for brand-new magic-link users.
SIGNUP_TOONTOON_BALANCE=3

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# GPT-4o mini: builds image prompts from tile answers + handles chat replies.
# Leave empty to fall back to the basic (non-GPT) prompt builder.
OPENAI_API_KEY=

# Model used for prompt building and chat. gpt-4o-mini is cheapest (~$0.0001/msg).
OPENAI_MODEL=gpt-4o-mini
# Разбор фразы по слотам — отдельная модель, выбранная замером (scripts/eval_slots.py).
# Работает только через витрину; пусто — общая текстовая модель.
SLOT_EXTRACTION_MODEL=google/gemini-2.5-flash

# ─── Generation ───────────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=30
IMAGE_TOONTOON_COST=1
VIDEO_TOONTOON_COST=2
POLLINATIONS_IMAGE_URL=https://image.pollinations.ai

# Kling — заполняется ОДНО из двух, смотря какая консоль досталась аккаунту.
# Новая «API Platform» (kling.ai/dev/api-key) выдаёт один ключ api-key-kling-…
KLING_API_KEY=
# Старая «Open Platform» выдаёт пару; тогда JWT собирается на нашей стороне.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_IMAGE_MODEL=kling-v3-0
# Сила референса: 0 — «только вдохновись», 1 — «держись исходника».
# Работают на kling-v2-1 и старше; у kling-v3-0 таких ручек нет.
KLING_IMAGE_FIDELITY=0.5
KLING_HUMAN_FIDELITY=0.8

# ─── Boostify (v2 — identity + wallet) ────────────────────────────────────────
# Boostify is not live yet, so keep mock mode on. Real endpoints are wired but
# only called when BOOSTIFY_MOCK=false.
BOOSTIFY_MOCK=true
BOOSTIFY_BASE_URL=https://api.boostify.example
BOOSTIFY_CLIENT_ID=toontoon
BOOSTIFY_CLIENT_SECRET=change-me
BOOSTIFY_REDIRECT_URI=http://localhost:8000/api/auth/boostify/callback
BOOSTIFY_WEBHOOK_SECRET=change-me-too
