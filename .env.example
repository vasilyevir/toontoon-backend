# ─── Образец окружения TOONTOON backend ──────────────────────────────────────
#
# Здесь перечислено ВСЁ, что читает app/config.py. Значения — умолчания из кода
# и годятся для машины разработчика; в кластере они приходят из ConfigMap
# (не-секретные) и Secret <release>-secrets (ключи).
#
# ⚠ ОБЯЗАТЕЛЬНО задать перед публикацией — помечено «прод:».
# Всё остальное имеет разумное умолчание и трогается по надобности.

# ─── Приложение ──────────────────────────────────────────────────────────────
APP_NAME=TOONTOON API
# прод: false. С DEBUG=true молчат проверки при старте, которые ловят
# оставленные включёнными отладочные флаги.
DEBUG=true

# Кому позволено обращаться из браузера. Список через запятую.
# прод: домен фронтенда, не "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Свой публичный адрес — из него строятся абсолютные ссылки и адрес
# возврата Google OAuth. прод: https://api.…
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
AUTH_SUCCESS_REDIRECT=/generate

# ─── PostgreSQL — система записи ─────────────────────────────────────────────
# прод: обязателен, из Secret. Пользователи, кошелёк, генерации, разговоры и
# профили лиц живут здесь. Схему накатывает `alembic upgrade head` ДО старта
# пода (в чарте — initSchema), а не приложение при запуске.
# Порт 5433 локально: 5432 обычно занят контейнером другого проекта.
DATABASE_URL=postgresql+asyncpg://toontoon:toontoon@localhost:5433/toontoon
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ─── Redis — сессии, кэш, ограничители, замки ────────────────────────────────
# прод: обязателен, из Secret. Не система записи: потеря Redis разлогинивает,
# но ничего не теряет.
REDIS_URL=redis://localhost:6379/0
# Redis в памяти процесса — для тестов и работы без контейнеров.
USE_FAKE_REDIS=false

# ─── Хранилище снимков и результатов ─────────────────────────────────────────
# прод: s3 (в кластере это MinIO). "local" пишет в ./uploads и приватность
# обеспечить не может — только для разработки.
STORAGE_BACKEND=s3
# прод: адрес MinIO в кластере; пусто — настоящий AWS.
S3_ENDPOINT_URL=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=toontoon-dev
# прод: обязательны, из Secret. Ниже — учётные данные локального MinIO.
S3_ACCESS_KEY=toontoon
S3_SECRET_KEY=toontoon-dev-secret
# Результаты приватны: клиент получает короткую подписанную ссылку, а не
# сырой адрес объекта. Хватает открыть галерею, назавтра утёкшая ссылка мертва.
S3_SIGNED_URL_TTL_SECONDS=900
# Обложки для сетки истории: полноразмерный кадр не должен быть тем, что
# скачивает лента по три в ряд.
THUMBNAIL_MAX_SIDE=512
THUMBNAIL_QUALITY=82

# ─── Сессии ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=toontoon-session
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
# Фронтенд и бэкенд на разных доменах → samesite=none и secure=true (нужен HTTPS).
# Когда фронтенд проксирует /api к себе (один домен), хватает lax.
SESSION_COOKIE_SAMESITE=lax
# прод: true. Иначе ключ сессии уедет по открытому HTTP.
SESSION_COOKIE_SECURE=false

# ─── Подпись запросов приложения (docs/APP-KEY-SETUP.md) ─────────────────────
# Выключено по умолчанию: с APP_KEY_REQUIRED=true любой запрос к /api/*,
# не подписанный приложением, отвергается. Включать ТОЛЬКО когда мобильное
# проверено, а веб и вебхуки либо исключены, либо тоже подписывают.
# Значения обязаны совпадать с Config.xcconfig приложения.
APP_KEY=
APP_SECRET=
APP_KEY_REQUIRED=false
APP_SIG_MAX_SKEW_SECONDS=300
# Пути, которые не проверяются подписью никогда: загрузки (multipart) и
# вебхуки (стучатся чужие).
APP_KEY_EXEMPT_PREFIXES=/api/uploads,/api/webhooks

# ─── Экономика (docs/ECONOMY.md) ─────────────────────────────────────────────
SIGNUP_TOONTOON_BALANCE=30
# Дни 1–5 по 10, шестой 20, седьмой 30 — ровно 100 за неделю.
DAILY_REWARD_SCHEDULE=10,10,10,10,10,20,30
# Потолок несгораемой корзины: без него неактивный пользователь накопит
# за месяц залп дорогих генераций.
FREE_BALANCE_CAP=300
FREE_WEEKLY_QUOTA=100
RATE_LIMIT_PER_HOUR=30
IMAGE_TOONTOON_COST=15
VIDEO_TOONTOON_COST=175

# ─── OpenRouter — единственная витрина моделей ───────────────────────────────
# прод: ключ обязателен, из Secret. Без него не работает ни генерация,
# ни разбор фразы, ни сборка промптов.
# ─── fal.ai ───────────────────────────────────────────────────────────────────
# Витрина, как и OpenRouter. Ключ с fal.ai → Dashboard → Keys.
#
# Пустой ключ = исполнитель не участвует: строки в реестре заведены и стоят
# первыми, но реестр проходит мимо и работает прежний OpenRouter. Появился
# ключ — fal становится основным сам, без релиза и без правки базы.
#
# Строк две, потому что у fal текст-в-кадр и правка кадра — разные модели:
#   fal_nano       text_to_image   fal-ai/nano-banana
#   fal_nano_edit  image_to_image  fal-ai/nano-banana/edit
# Поменять модель — UPDATE одной строки, а не релиз.
FAL_API_KEY=
# Очередь, а не синхронный fal.run: кадр рисуется до минуты.
FAL_BASE_URL=https://queue.fal.run
FAL_REQUEST_TIMEOUT=150
FAL_POLL_INTERVAL=1.5
FAL_ASPECT_RATIO=9:16
FAL_OUTPUT_FORMAT=png

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Вертикаль: продукт мобильный, квадрат на телефоне выглядит обрезанным.
OPENROUTER_ASPECT_RATIO=9:16
OPENROUTER_RESOLUTION=1K
OPENROUTER_OUTPUT_FORMAT=png
# Ступень качества у тех, кто её принимает. Это и цена тоже: между краями
# шкалы разница больше десяти раз. Не auto — он молча скачет втрое.
OPENROUTER_QUALITY=medium
# Сколько ждать модель, прежде чем уйти к следующей. Замер по базе: самая
# долгая удачная работа — 53 секунды, девяносто пятый процентиль 42. Завышенный
# порог стоит не денег, а ожидания: зависший исполнитель съедает его целиком
# ДО того, как начнётся попытка уйти к запасному.
OPENROUTER_REQUEST_TIMEOUT=90.0
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
# Разбор фразы по слотам — отдельная модель, выбранная замером
# (scripts/eval_slots.py). Пусто — уйдёт на общую текстовую.
SLOT_EXTRACTION_MODEL=google/gemini-2.5-flash
# Сколько снимков профиля идёт в модель референсами. Один — по замеру
# 25 августа 2026; профиль при этом хранит все пятнадцать.
PROFILE_REFERENCE_COUNT=1
# Сколько последних сообщений уходит в модель.
CHAT_CONTEXT_MESSAGES=20

# ─── OpenAI напрямую (запасной путь рисования) ───────────────────────────────
# Пусто — адаптер выключен, и реестр провайдеров уводит запрос дальше.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT=55.0

# ─── Видео (kie.ai / ByteDance Seedance) ─────────────────────────────────────
# ВЫКЛЮЧЕНО в первой версии: все шесть направлений онбординга про фото, а
# пятисекундный клип стоит $1.21–1.52. Код остаётся, маршрут закрыт флагом.
VIDEO_ENABLED=false
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_VIDEO_MODEL=bytedance/seedance-2-fast
KIE_VIDEO_AUDIO_MODEL=bytedance/seedance-2
VIDEO_FRAME_COUNT=4
VIDEO_RESOLUTION=720p
VIDEO_ASPECT_RATIO=9:16
VIDEO_DURATION=5
VIDEO_POLL_INTERVAL=6.0
VIDEO_POLL_TIMEOUT=900.0

# ─── Вход через Apple и покупки StoreKit ─────────────────────────────────────
# прод: BUNDLE_ID обязателен — по нему проверяется, что чек выписан нашему
# приложению, а не чужому. SERVICE_ID нужен только для веба.
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=
# ⚠ прод: ОБЯЗАТЕЛЬНО false. Принимает чеки, подписанные локальным корнем
# StoreKit из Xcode. Сертификат этот лежит внутри Xcode у всех — с ним любой
# выпишет себе подписку сам. Приложение при старте кричит, если DEBUG
# выключен, а это включено.
ACCEPT_STOREKIT_TEST_ROOT=false

# ─── Вход через Google ───────────────────────────────────────────────────────
# Пусто — маршруты отвечают 503 «не настроено» вместо 404.
# Google Cloud Console → OAuth client ID, тип Web application (один и тот же
# и для веба, и для приложения: приложение открывает тот же экран согласия).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Пусто — выведется как {PUBLIC_BASE_URL}/api/auth/google/callback.
GOOGLE_REDIRECT_URI=
# Своя схема ссылок: после согласия в браузере приложение ловит по ней сессию.
APP_DEEP_LINK_SCHEME=toontoon

# ─── Push (VAPID, веб) ───────────────────────────────────────────────────────
# Пусто — уведомления выключены. Пара выпускается `vapid --gen`.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:hello@toontoon.ai

# ─── Cloudinary — надписи поверх видео ───────────────────────────────────────
# Пусто — видео отдаются без надписей.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Отладочное. В проде ОБЯЗАНО отсутствовать ───────────────────────────────
# Возвращает токены magic-link и сброса пароля прямо в ответе API вместо
# письма — пока в кластере нет SMTP, это единственный способ их пройти.
# Умолчание в коде false: развёртывание, где переменную забыли, не должно
# отдавать токен сброса пароля к любому аккаунту по открытому запросу.
# EXPOSE_DEV_TOKENS=true

# ─── Где рисуется кадр ────────────────────────────────────────────────────
# inline — фоновой задачей внутри веб-процесса (умолчание; деплой убивает
#          всё, что рисуется). queue — заказ в Redis, рисует `python -m app.worker`,
#          который при старте подбирает недорисованное. Прод: queue + воркер в чарте.
WORKER_MODE=inline
# Сколько кадров воркер рисует разом (fal держит ≥ 6; Pillow — в пуле потоков).
WORKER_CONCURRENCY=4
# fal: сколько ждать в очереди отдельно от самой работы (сек).
FAL_QUEUE_TIMEOUT=120
# Принимать чеки из песочницы App Store (TestFlight). Уже, чем ACCEPT_STOREKIT_TEST_ROOT:
# корень Apple настоящий, отличается только environment. Прототип: true. Прод: false.
ACCEPT_SANDBOX_RECEIPTS=false
